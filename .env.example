# Local mock admin token only; evaluator uses an independent random secret.
ADMIN_TOKEN=local-development-only
# Optional model provider. Without a key the agent runs its deterministic rules-only path.
# MODEL_API_KEY=
# Defaults: Gemini via Google's OpenAI-compatible API. For OpenRouter use https://openrouter.ai/api/v1 and deepseek/deepseek-v4-flash.
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_NAME=gemini-3.1-flash-lite
# Cost estimate (USD per million tokens) for providers that report no per-call cost:
# MODEL_PRICE_IN_PER_M=0.25
# MODEL_PRICE_OUT_PER_M=1.50
